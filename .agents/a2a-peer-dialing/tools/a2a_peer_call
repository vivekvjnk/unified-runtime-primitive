#!/usr/bin/env python3
"""
A2A Peer Dialing CLI Tool.
Enables agents with bash execution capabilities to delegate sub-tasks to peer A2A agents.

Usage:
  a2a_peer_call --peer <peer_agent_name> --message "<request text>" [--url <host_url>] [--context-id <id>]
"""

import argparse
import asyncio
import json
import os
import sys

# Suppress OpenHands banner on stdout
os.environ.setdefault("OPENHANDS_SUPPRESS_BANNER", "1")

# Ensure urp is importable if run from source
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "..")))

from urp.a2a.client import a2a_call_peer


def main():
    parser = argparse.ArgumentParser(description="Call a peer A2A agent within the URP network.")
    parser.add_argument("--peer", required=True, help="Target peer agent name (e.g. tiny_infra_agent)")
    parser.add_argument("--message", required=True, help="Message / instruction text for the peer")
    parser.add_argument("--url", default=os.getenv("A2A_HOST_URL", "http://127.0.0.1:8000"), help="Base A2A host URL")
    parser.add_argument("--context-id", default=None, help="Conversational context session ID")
    parser.add_argument("--task-id", default=None, help="Specific task ID anchor")
    parser.add_argument("--timeout", type=float, default=180.0, help="Execution timeout in seconds")

    args = parser.parse_args()

    try:
        result = asyncio.run(
            a2a_call_peer(
                peer_name=args.peer,
                message=args.message,
                base_url=args.url,
                context_id=args.context_id,
                task_id=args.task_id,
                timeout=args.timeout,
            )
        )
        # Output clean JSON for the caller agent
        print(json.dumps(result, indent=2))
        if result.get("state") == "TASK_STATE_FAILED":
            sys.exit(1)
    except Exception as e:
        err_payload = {
            "error": str(e),
            "peer": args.peer,
            "state": "TASK_STATE_FAILED",
        }
        print(json.dumps(err_payload, indent=2), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
